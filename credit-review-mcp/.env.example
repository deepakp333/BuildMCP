# Anthropic (optional — deterministic memo fallback if unset)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_OUTPUT_TOKENS=900
USE_LLM_FOR_MEMO=false
USE_LLM_FOR_SENTIMENT=false

# SEC EDGAR (required for real SEC calls)
SEC_USER_AGENT=CreditReviewDemo contact@example.com

# Demo controls
MAX_COMPANIES_DEFAULT=5
CACHE_TTL_SECONDS=3600
HTTP_TIMEOUT_SECONDS=30

# News adapters (optional)
NEWS_API_KEY=
REUTERS_API_KEY=
BLOOMBERG_API_KEY=
