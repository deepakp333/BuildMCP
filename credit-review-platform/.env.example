# External API keys (optional — platform works with public endpoints + fallbacks)
NEWS_API_KEY=
COURTLISTENER_API_TOKEN=
SEC_USER_AGENT=CreditReviewPlatform contact@example.com

# MCP server command
MCP_SERVER_MODULE=mcp_server.server

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO
